# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild instantly (otherwise global, ~1h)
# DISCORD_GUILD_ID=

# Spotify Web API — client credentials, metadata only (no audio streams)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Archipelago room. Leave AP_HOST empty to connect later with /connect.
AP_HOST=
AP_PORT=38281
AP_SLOT=
AP_PASSWORD=
AP_GAME=Needlecheck

# Crate baked into the apworld. Mount the crate.json from the world pack here.
CRATE_PATH=/data/crate.json

# Optional: text channel id for unlock / first-play announcements
# ANNOUNCE_CHANNEL_ID=

# Optional: yt-dlp cookies file if YouTube blocks the host
# YTDLP_COOKIES=/data/cookies.txt
