# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional. Registers slash commands on one server immediately. Without it, global commands can take an hour.
# DISCORD_GUILD_ID=

# Archipelago. Leave AP_HOST empty and use /connect, which can point at a different room without a restart.
AP_HOST=
AP_PORT=38281
AP_SLOT=
AP_PASSWORD=
AP_GAME=Needlecheck

# Host folder mounted into both containers at /music. This is the only path to change.
# Relative to the directory you run docker compose from, or an absolute path.
MUSIC_DIR=./music

# The builder lists that folder unless this is 1. The bot ignores it.
# NEEDLECHECK_ONLINE=1

# YouTube is off unless this is 1. File tracks do not fall back to a search.
YOUTUBE=0
# Optional Netscape cookies file if you turn YouTube on and the host is blocked.
# YTDLP_COOKIES=/data/cookies.txt

# Optional text channel for unlocks and first plays.
# ANNOUNCE_CHANNEL_ID=
