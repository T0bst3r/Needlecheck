{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T0bst3r/Needlecheck/blob/crate-yaml/apworld/needlecheck/crate.schema.json",
  "title": "Needlecheck crate",
  "description": "The value of Needlecheck.crate in a player YAML file. The apworld is generic; this list is the slot.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/album" },
  "$defs": {
    "album": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "artist", "tracks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "artist": { "type": "string", "minLength": 1 },
        "starter": { "type": "boolean" },
        "year": { "type": "integer" },
        "artwork": { "type": "string" },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/track" }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "artist": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "const": "youtube" },
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "const": "file" },
                "path": { "type": "string", "minLength": 1, "maxLength": 400 }
              }
            }
          ]
        }
      }
    }
  }
}
